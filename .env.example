NODE_ENV=development
PORT=3000

# Demostración local; cambia estos valores para cualquier entorno compartido.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mocca_go
DB_USERNAME=mocca_go
DB_PASSWORD=mocca_go_local_only
DB_SCHEMA=public
DB_SSL=false

# Solo crea usuarios que aún no existan; no reinicia contraseñas.
SEED_ADMIN_PASSWORD=change-admin-password
SEED_OPERATOR_PASSWORD=change-operator-password
SEED_COURIER_PASSWORD=change-courier-password

# JWT_SECRET no se incluye: genéralo con el comando del README, que lo añade a .env.
# Nunca reutilices una clave local en producción ni la publiques.

# Proxies de confianza delante de la API: 0 en local, 1 en Railway.
TRUST_PROXY_HOPS=0

# Duración del JWT en segundos (60 a 86400). Por defecto 900 (15 minutos).
ACCESS_TOKEN_TTL_SECONDS=28800

# Orígenes del frontend (Next.js) permitidos por CORS, separados por comas.
# Sin comodín, sin ruta ni "/" final. Vacío desactiva CORS.
CORS_ORIGINS=http://localhost:3001
